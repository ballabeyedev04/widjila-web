# URL de base de l'API backend (voir backend/.env → HOST + PORT + préfixe /api/v1)
VITE_API_BASE_URL=http://127.0.0.1:3109/api/v1

# Clé publique Stripe (pour Stripe Elements / PaymentIntent côté client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACER_PAR_VOTRE_CLE

# PayTech - Activer le paiement mobile (Orange Money, Wave, Free Money)
# Mettre à 'true' pour activer PayTech en plus de Stripe
VITE_USE_PAYTECH=false

# Monitoring d'erreurs (Sentry) — optionnel. Sans cette variable, l'app
# fonctionne normalement (les erreurs restent seulement dans la console du
# navigateur, comme avant). Avec un DSN, chaque écran cassé remonte à votre
# équipe au lieu d'être découvert via un appel client.
# Créer un projet React sur https://sentry.io (gratuit jusqu'à un certain
# volume) pour obtenir ce DSN.
VITE_SENTRY_DSN=
