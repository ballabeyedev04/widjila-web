# Dépendances
node_modules/

# Build
dist/

# Environnement local (garder .env.example)
# CORRECTIF : `.env` n'était pas ignoré (seuls .env.local / .env.production
# l'étaient) — le fichier de config réel, secrets compris, pouvait donc être
# committé par mégarde. Aligné sur le .gitignore du backend.
.env
.env.local
.env.production
.env.*.local
*.local
!.env.example

# Logs
*.log
npm-debug.log*

# Éditeurs
.vscode/
.idea/
.DS_Store

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Worker pdf.js — copié depuis node_modules par `scripts/copier-worker-pdf.js`
# (predev / prebuild). Versionner un binaire de 1,2 Mo le ferait diverger de la
# version réellement installée de `pdfjs-dist` au premier `npm update`.
public/pdf.worker.min.mjs
# Polices standard de pdf.js, recopiées depuis node_modules par
# `scripts/copier-worker-pdf.js` (predev / prebuild) — même raison que le
# worker : elles suivent la version installée et n'ont pas à être versionnées.
public/standard_fonts/
